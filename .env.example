# === slavimo.hr environment varijable ===

# Javni URL stranice (koristi se za canonical, sitemap, OG tagove)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin autentikacija (OBAVEZNO u produkciji — admin je fail-closed bez ovoga) ---
# E-mail administratora
ADMIN_EMAIL=admin@example.com
# Hash lozinke u formatu scrypt:<salt-hex>:<hash-hex>
# Generiraj lokalno:  node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');c.scrypt(process.argv[1],s,64,(e,k)=>console.log('scrypt:'+s+':'+k.toString('hex')))" 'TvojaLozinka'
ADMIN_PASSWORD_HASH=
# Tajna za potpisivanje session cookieja (min. 32 znaka): openssl rand -hex 32
AUTH_SECRET=

# --- Baza ---
# Putanja do SQLite datoteke (default: ./data/festko.db)
DATABASE_PATH=./data/festko.db

# --- E-mail obavijesti (opcionalno — bez ovoga se obavijesti samo logiraju) ---
# Adapter: "console" (default) ili "resend"
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=slavimo.hr <info@example.com>
# Adresa na koju stižu admin obavijesti o novim upitima/zahtjevima
ADMIN_NOTIFY_EMAIL=

# --- Analitika (opcionalno, first-party analitika radi i bez ovoga) ---
NEXT_PUBLIC_ANALYTICS_PROVIDER=
